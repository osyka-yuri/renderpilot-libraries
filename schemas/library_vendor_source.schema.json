{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://osyka-yuri.github.io/renderpilot-libraries/schemas/library_vendor_source.schema.json",
  "title": "RenderPilot curated library vendor source",
  "type": "object",
  "required": [
    "schema_version",
    "vendor",
    "generated_at",
    "legal_documents",
    "artifacts",
    "packages"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "vendor": { "$ref": "#/$defs/vendor" },
    "generated_at": { "type": "string", "format": "date-time" },
    "legal_documents": {
      "type": "array",
      "items": { "$ref": "#/$defs/legalDocument" }
    },
    "artifacts": {
      "type": "array",
      "items": { "$ref": "#/$defs/artifact" }
    },
    "packages": {
      "type": "array",
      "items": { "$ref": "#/$defs/package" }
    }
  },
  "$defs": {
    "vendor": {
      "type": "object",
      "required": ["id", "display_name"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "display_name": { "type": "string", "minLength": 1 }
      }
    },
    "artifact": {
      "type": "object",
      "required": [
        "artifact_key",
        "library_id",
        "file_name",
        "file_version",
        "architecture",
        "dll",
        "transport",
        "signature"
      ],
      "additionalProperties": false,
      "properties": {
        "artifact_key": { "$ref": "#/$defs/id" },
        "library_id": { "$ref": "#/$defs/id" },
        "file_name": { "$ref": "#/$defs/dllName" },
        "file_version": {
          "anyOf": [{ "$ref": "#/$defs/version" }, { "type": "null" }]
        },
        "architecture": { "$ref": "#/$defs/architecture" },
        "pe_named_exports": { "$ref": "#/$defs/peNamedExports" },
        "pe_imports": { "$ref": "#/$defs/peImports" },
        "dll": { "$ref": "#/$defs/content" },
        "transport": { "$ref": "#/$defs/sourceTransport" },
        "signature": { "$ref": "#/$defs/signature" },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "package": {
      "type": "object",
      "required": [
        "package_id",
        "technology",
        "variant",
        "display_name",
        "release",
        "target",
        "members"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "release": { "required": ["components"] }
            },
            "required": ["release"]
          },
          "then": { "required": ["provenance"] }
        }
      ],
      "properties": {
        "package_id": { "$ref": "#/$defs/id" },
        "technology": { "$ref": "#/$defs/id" },
        "variant": { "$ref": "#/$defs/id" },
        "display_name": {
          "description": "User-facing package name. Presentation-only metadata excluded from package revision identity.",
          "type": "string",
          "minLength": 1
        },
        "release": { "$ref": "#/$defs/release" },
        "target": { "$ref": "#/$defs/target" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "legal_document_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/legalDocumentId" }
        },
        "members": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sourceMember" }
        },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "sourceMember": {
      "type": "object",
      "required": ["artifact_key", "role", "install_as"],
      "additionalProperties": false,
      "properties": {
        "artifact_key": { "$ref": "#/$defs/id" },
        "component": { "$ref": "#/$defs/id" },
        "role": { "$ref": "#/$defs/id" },
        "install_as": { "$ref": "#/$defs/dllName" }
      }
    },
    "content": {
      "type": "object",
      "required": ["sha256", "size_bytes"],
      "additionalProperties": false,
      "properties": {
        "sha256": { "$ref": "#/$defs/sha256" },
        "size_bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "legalDocument": {
      "type": "object",
      "required": ["legal_document_id", "kind", "title", "format", "file_name", "content"],
      "additionalProperties": false,
      "properties": {
        "legal_document_id": { "$ref": "#/$defs/legalDocumentId" },
        "kind": { "enum": ["license", "notice"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 256 },
        "format": { "enum": ["text", "pdf"] },
        "file_name": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._-]+\\.(?:md|pdf|txt)$"
        },
        "content": { "$ref": "#/$defs/legalContent" }
      }
    },
    "legalContent": {
      "type": "object",
      "required": ["sha256", "size_bytes"],
      "additionalProperties": false,
      "properties": {
        "sha256": { "$ref": "#/$defs/sha256" },
        "size_bytes": { "type": "integer", "minimum": 1, "maximum": 16777216 }
      }
    },
    "sourceTransport": {
      "description": "Provider-neutral compressed-payload identity projected into the public transport contract.",
      "type": "object",
      "required": ["sha256", "size_bytes"],
      "additionalProperties": false,
      "properties": {
        "sha256": { "$ref": "#/$defs/sha256" },
        "size_bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "release": {
      "type": "object",
      "required": ["version", "channel", "label"],
      "additionalProperties": false,
      "properties": {
        "version": {
          "description": "Canonical package version used for presentation, ordering, and candidate selection.",
          "$ref": "#/$defs/packageVersion"
        },
        "channel": {
          "description": "Behaviorally significant release stability channel.",
          "enum": ["stable", "beta", "preview", "debug"]
        },
        "label": {
          "description": "Optional concise annotation appended verbatim to the package version. It must contain only supplemental information and must not repeat the package version or display name.",
          "type": ["string", "null"],
          "minLength": 1
        },
        "components": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/packageVersion" },
          "propertyNames": { "$ref": "#/$defs/id" }
        }
      }
    },
    "target": {
      "type": "object",
      "required": ["os", "architecture"],
      "additionalProperties": false,
      "properties": {
        "os": { "const": "windows" },
        "architecture": { "$ref": "#/$defs/architecture" },
        "compatibility": { "$ref": "#/$defs/compatibility" }
      }
    },
    "compatibility": {
      "type": "object",
      "required": ["kind", "version"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "d3d12_sdk" },
        "version": { "type": "integer", "minimum": 1 }
      }
    },
    "provenance": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "package_id", "version", "package_sha512"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "nuget" },
            "package_id": { "type": "string", "minLength": 1 },
            "version": { "$ref": "#/$defs/packageVersion" },
            "package_sha512": {
              "type": "string",
              "pattern": "^[A-Za-z0-9+/]{86}==$"
            }
          }
        },
        {
          "type": "object",
          "required": ["kind", "repository", "tag", "commit_sha"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "github_release" },
            "repository": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
            },
            "tag": { "type": "string", "minLength": 1 },
            "commit_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
          }
        },
        {
          "$ref": "#/$defs/sourceBuild"
        }
      ]
    },
    "sourceBuild": {
      "type": "object",
      "required": [
        "kind",
        "sources",
        "build_revision",
        "recipe_sha256",
        "verification_policy_sha256",
        "patches",
        "toolchain"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "source_build" },
        "sources": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/sourceInput" },
          "propertyNames": { "$ref": "#/$defs/id" }
        },
        "build_revision": { "type": "integer", "minimum": 1 },
        "recipe_sha256": { "$ref": "#/$defs/sha256" },
        "verification_policy_sha256": { "$ref": "#/$defs/sha256" },
        "patches": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/sourcePatch" },
          "propertyNames": { "$ref": "#/$defs/id" }
        },
        "toolchain": {
          "type": "object",
          "required": ["runner_image", "compiler", "linker", "windows_sdk", "cmake"],
          "additionalProperties": false,
          "properties": {
            "runner_image": { "type": "string", "minLength": 1 },
            "compiler": { "type": "string", "minLength": 1 },
            "linker": { "type": "string", "minLength": 1 },
            "windows_sdk": { "type": "string", "minLength": 1 },
            "cmake": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "sourcePatch": {
      "type": "object",
      "required": [
        "source",
        "target",
        "descriptor_sha256",
        "original_sha256",
        "patched_sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "source": { "$ref": "#/$defs/id" },
        "target": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.?(/|$))(?!.*\\\\).+$"
        },
        "descriptor_sha256": { "$ref": "#/$defs/sha256" },
        "original_sha256": { "$ref": "#/$defs/sha256" },
        "patched_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "sourceInput": {
      "type": "object",
      "required": [
        "repository",
        "version",
        "tag",
        "tag_object_sha",
        "commit_sha",
        "archive_url",
        "archive_sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
        "version": { "$ref": "#/$defs/version" },
        "tag": { "type": ["string", "null"], "minLength": 1 },
        "tag_object_sha": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{40}$"
        },
        "commit_sha": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{40}$"
        },
        "archive_url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "archive_sha256": { "$ref": "#/$defs/sha256" }
      },
      "oneOf": [
        {
          "properties": {
            "tag": { "type": "string", "minLength": 1 },
            "tag_object_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "commit_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
          }
        },
        {
          "properties": {
            "tag": { "type": "null" },
            "tag_object_sha": { "type": "null" },
            "commit_sha": { "type": "null" }
          }
        }
      ]
    },
    "peNamedExports": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16384,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[ -~]+$"
      }
    },
    "peImports": {
      "type": "object",
      "required": ["regular", "delay"],
      "additionalProperties": false,
      "properties": {
        "regular": { "$ref": "#/$defs/peImportNames" },
        "delay": { "$ref": "#/$defs/peImportNames" }
      }
    },
    "peImportNames": {
      "type": "array",
      "maxItems": 4096,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 256,
        "pattern": "^[a-z0-9._-]+\\.dll$"
      }
    },
    "signature": {
      "oneOf": [
        {
          "type": "object",
          "required": ["status"],
          "additionalProperties": false,
          "properties": { "status": { "const": "unsigned" } }
        },
        {
          "type": "object",
          "required": ["status", "signed_at"],
          "additionalProperties": false,
          "properties": {
            "status": { "const": "signed" },
            "subject": {
              "description": "Signer subject when certificate metadata was captured; older curated records may omit it.",
              "type": "string",
              "minLength": 1
            },
            "thumbprint": {
              "description": "Signer certificate thumbprint when captured; older curated records may omit it.",
              "type": "string",
              "pattern": "^[A-F0-9]{40,64}$"
            },
            "signed_at": {
              "description": "Verified or historically recorded signing time. Generated providers use null only when no timestamp attribute exists; older curated records can be incomplete.",
              "type": ["string", "null"],
              "format": "date-time"
            }
          }
        }
      ]
    },
    "extensions": { "type": "object", "additionalProperties": true },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]*$" },
    "legalDocumentId": {
      "type": "string",
      "pattern": "^(?:license|notice)\\.[0-9a-f]{64}$"
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "dllName": { "type": "string", "pattern": "^[A-Za-z0-9._-]+\\.dll$" },
    "architecture": { "enum": ["X64", "X86"] },
    "version": {
      "type": "string",
      "pattern": "^(?:0|[1-9]\\d*)(?:\\.(?:0|[1-9]\\d*))*$"
    },
    "packageVersion": {
      "type": "string",
      "description": "Canonical NuGet/SemVer2 identity with build metadata removed.",
      "pattern": "^(?:0|[1-9]\\d*)(?:\\.(?:0|[1-9]\\d*)){0,3}(?:-[0-9a-z-]+(?:\\.[0-9a-z-]+)*)?$"
    }
  }
}
