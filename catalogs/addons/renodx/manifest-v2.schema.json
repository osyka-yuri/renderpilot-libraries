{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://renderpilot.app/schema/addons/v2/renodx.json",
  "title": "RenoDX v2 manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "games",
    "engine_profiles",
    "page_guidance"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "generated_at": { "type": "string", "format": "date-time" },
    "games": { "type": "array", "items": { "$ref": "#/$defs/game" } },
    "engine_profiles": { "type": "array", "items": { "$ref": "#/$defs/engineProfile" } },
    "page_guidance": { "type": "array", "items": { "$ref": "#/$defs/guidance" } }
  },
  "$defs": {
    "status": { "enum": ["working", "construction", "unknown"] },
    "architecture": { "enum": ["X86", "X64"] },
    "engine": { "enum": ["unreal", "unity"] },
    "processingPath": { "enum": ["upgrade", "native", "unmanaged"] },
    "renodxConfigSetting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "value"],
      "properties": {
        "key": {
          "enum": [
            "Upgrade_B8G8R8A8_TYPELESS",
            "Upgrade_B8G8R8A8_UNORM",
            "Upgrade_R8G8B8A8_TYPELESS",
            "Upgrade_R8G8B8A8_UNORM",
            "Upgrade_R10G10B10A2_UNORM",
            "Upgrade_R10G10B10A2_TYPELESS",
            "Upgrade_R11G11B10_FLOAT",
            "Upgrade_R16G16B16A16_TYPELESS",
            "Upgrade_CopyDestinations",
            "ForceBorderless",
            "Upgrade_UseSCRGB",
            "Swapchain_Encoding",
            "Scaling_Offset",
            "Tonemap_Offset",
            "Blit_Copy_Hack",
            "Use_Swapchain_Proxy",
            "Force_Pipeline_Cloning",
            "ColorGradeContrast",
            "ColorGradeSaturation",
            "ColorGradeBlowout"
          ]
        },
        "value": { "type": "integer", "minimum": 0, "maximum": 100 }
      },
      "allOf": [
        {
          "if": {
            "required": ["key"],
            "properties": {
              "key": {
                "enum": [
                  "Upgrade_B8G8R8A8_TYPELESS",
                  "Upgrade_B8G8R8A8_UNORM",
                  "Upgrade_R8G8B8A8_TYPELESS",
                  "Upgrade_R8G8B8A8_UNORM",
                  "Upgrade_R10G10B10A2_UNORM",
                  "Upgrade_R10G10B10A2_TYPELESS",
                  "Upgrade_R11G11B10_FLOAT",
                  "Upgrade_R16G16B16A16_TYPELESS"
                ]
              }
            }
          },
          "then": { "properties": { "value": { "maximum": 3 } } }
        },
        {
          "if": {
            "required": ["key"],
            "properties": {
              "key": { "enum": ["Upgrade_CopyDestinations", "Use_Swapchain_Proxy"] }
            }
          },
          "then": { "properties": { "value": { "maximum": 2 } } }
        },
        {
          "if": {
            "required": ["key"],
            "properties": {
              "key": {
                "enum": [
                  "ForceBorderless",
                  "Upgrade_UseSCRGB",
                  "Swapchain_Encoding",
                  "Force_Pipeline_Cloning"
                ]
              }
            }
          },
          "then": { "properties": { "value": { "maximum": 1 } } }
        },
        {
          "if": {
            "required": ["key"],
            "properties": { "key": { "enum": ["Scaling_Offset", "Tonemap_Offset"] } }
          },
          "then": { "properties": { "value": { "maximum": 8 } } }
        },
        {
          "if": {
            "required": ["key"],
            "properties": { "key": { "const": "Blit_Copy_Hack" } }
          },
          "then": { "properties": { "value": { "maximum": 3 } } }
        }
      ]
    },
    "renodxConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["settings"],
      "allOf": [
        {
          "not": {
            "properties": {
              "settings": {
                "contains": {
                  "required": ["key"],
                  "properties": { "key": { "const": "Upgrade_B8G8R8A8_TYPELESS" } }
                },
                "minContains": 2
              }
            }
          }
        },
        {
          "not": {
            "properties": {
              "settings": {
                "contains": {
                  "required": ["key"],
                  "properties": { "key": { "const": "Upgrade_B8G8R8A8_UNORM" } }
                },
                "minContains": 2
              }
            }
          }
        },
        {
          "not": {
            "properties": {
              "settings": {
                "contains": {
                  "required": ["key"],
                  "properties": { "key": { "const": "Upgrade_R8G8B8A8_TYPELESS" } }
                },
                "minContains": 2
              }
            }
          }
        },
        {
          "not": {
            "properties": {
              "settings": {
                "contains": {
                  "required": ["key"],
                  "properties": { "key": { "const": "Upgrade_R8G8B8A8_UNORM" } }
                },
                "minContains": 2
              }
            }
          }
        },
        {
          "not": {
            "properties": {
              "settings": {
                "contains": {
                  "required": ["key"],
                  "properties": { "key": { "const": "Upgrade_R10G10B10A2_UNORM" } }
                },
                "minContains": 2
              }
            }
          }
        },
        {
          "not": {
            "properties": {
              "settings": {
                "contains": {
                  "required": ["key"],
                  "properties": { "key": { "const": "Upgrade_R10G10B10A2_TYPELESS" } }
                },
                "minContains": 2
              }
            }
          }
        },
        {
          "not": {
            "properties": {
              "settings": {
                "contains": {
                  "required": ["key"],
                  "properties": { "key": { "const": "Upgrade_R11G11B10_FLOAT" } }
                },
                "minContains": 2
              }
            }
          }
        },
        {
          "not": {
            "properties": {
              "settings": {
                "contains": {
                  "required": ["key"],
                  "properties": { "key": { "const": "Upgrade_R16G16B16A16_TYPELESS" } }
                },
                "minContains": 2
              }
            }
          }
        },
        {
          "not": {
            "properties": {
              "settings": {
                "contains": {
                  "required": ["key"],
                  "properties": { "key": { "const": "Upgrade_CopyDestinations" } }
                },
                "minContains": 2
              }
            }
          }
        },
        {
          "not": {
            "properties": {
              "settings": {
                "contains": {
                  "required": ["key"],
                  "properties": { "key": { "const": "ForceBorderless" } }
                },
                "minContains": 2
              }
            }
          }
        },
        {
          "not": {
            "properties": {
              "settings": {
                "contains": {
                  "required": ["key"],
                  "properties": { "key": { "const": "Upgrade_UseSCRGB" } }
                },
                "minContains": 2
              }
            }
          }
        },
        {
          "not": {
            "properties": {
              "settings": {
                "contains": {
                  "required": ["key"],
                  "properties": { "key": { "const": "Swapchain_Encoding" } }
                },
                "minContains": 2
              }
            }
          }
        },
        {
          "not": {
            "properties": {
              "settings": {
                "contains": {
                  "required": ["key"],
                  "properties": { "key": { "const": "Scaling_Offset" } }
                },
                "minContains": 2
              }
            }
          }
        },
        {
          "not": {
            "properties": {
              "settings": {
                "contains": {
                  "required": ["key"],
                  "properties": { "key": { "const": "Tonemap_Offset" } }
                },
                "minContains": 2
              }
            }
          }
        },
        {
          "not": {
            "properties": {
              "settings": {
                "contains": {
                  "required": ["key"],
                  "properties": { "key": { "const": "Blit_Copy_Hack" } }
                },
                "minContains": 2
              }
            }
          }
        },
        {
          "not": {
            "properties": {
              "settings": {
                "contains": {
                  "required": ["key"],
                  "properties": { "key": { "const": "Use_Swapchain_Proxy" } }
                },
                "minContains": 2
              }
            }
          }
        },
        {
          "not": {
            "properties": {
              "settings": {
                "contains": {
                  "required": ["key"],
                  "properties": { "key": { "const": "ColorGradeContrast" } }
                },
                "minContains": 2
              }
            }
          }
        },
        {
          "not": {
            "properties": {
              "settings": {
                "contains": {
                  "required": ["key"],
                  "properties": { "key": { "const": "ColorGradeSaturation" } }
                },
                "minContains": 2
              }
            }
          }
        },
        {
          "not": {
            "properties": {
              "settings": {
                "contains": {
                  "required": ["key"],
                  "properties": { "key": { "const": "ColorGradeBlowout" } }
                },
                "minContains": 2
              }
            }
          }
        },
        {
          "not": {
            "properties": {
              "settings": {
                "contains": {
                  "required": ["key"],
                  "properties": { "key": { "const": "Force_Pipeline_Cloning" } }
                },
                "minContains": 2
              }
            }
          }
        }
      ],
      "properties": {
        "settings": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/renodxConfigSetting" }
        }
      }
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "fallback_text"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "fallback_text": { "type": "string", "minLength": 1 }
      }
    },
    "guidanceCondition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "engine": { "$ref": "#/$defs/engine" },
        "unreal_major": { "type": "integer", "minimum": 4 },
        "unreal_minor_min": { "type": "integer", "minimum": 0 },
        "unreal_minor_max": { "type": "integer", "minimum": 0 }
      }
    },
    "setting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 }
      }
    },
    "engineIniEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "value"],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^(?=.*[^\\s])[^\\r\\n=]+$"
        },
        "value": {
          "type": "string",
          "pattern": "^(?=.*[^\\s])[^\\r\\n]+$"
        }
      }
    },
    "engineIniSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "entries"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^(?=.*[^\\s])[^\\r\\n\\[\\]]+$"
        },
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/engineIniEntry" }
        }
      }
    },
    "engineIniRecipe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "revision", "sections"],
      "properties": {
        "schema_version": { "const": 1 },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/engineIniSection" }
        }
      }
    },
    "guidance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "message_id", "fallback_text"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": [
            "game_setting",
            "addon_setting",
            "engine_ini",
            "warning",
            "compatibility",
            "external_tool"
          ]
        },
        "message_id": { "type": "string", "minLength": 1 },
        "fallback_text": { "type": "string", "minLength": 1 },
        "code": { "type": "string", "minLength": 1 },
        "settings": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/setting" }
        },
        "engine_ini": { "$ref": "#/$defs/engineIniRecipe" },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "condition": { "$ref": "#/$defs/guidanceCondition" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "engine_ini" } } },
          "then": { "required": ["code"] }
        },
        {
          "if": { "properties": { "kind": { "const": "addon_setting" } } },
          "then": { "required": ["settings"] }
        },
        {
          "if": { "required": ["engine_ini"] },
          "then": { "properties": { "kind": { "const": "engine_ini" } } }
        }
      ]
    },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value", "tier"],
      "properties": {
        "kind": {
          "enum": ["steam_appid", "epic_id", "gog_id", "xbox_store_id", "exe_name"]
        },
        "value": { "type": "string", "minLength": 1 },
        "tier": { "type": "integer", "minimum": 1 }
      }
    },
    "addon": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug"],
      "properties": {
        "slug": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
        "source": { "type": "string", "format": "uri", "pattern": "^https://" }
      }
    },
    "availability": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "url", "message"],
          "properties": {
            "kind": { "const": "external" },
            "url": { "type": "string", "format": "uri", "pattern": "^https://" },
            "message": { "$ref": "#/$defs/message" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "native_hdr" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "message"],
          "properties": {
            "kind": { "const": "blocked" },
            "message": { "$ref": "#/$defs/message" }
          }
        }
      ]
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "required_api": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": ["D3D9", "D3D10", "D3D11", "D3D12", "OpenGl", "Vulkan", "Unknown"]
          }
        },
        "conflicts": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "source": { "type": "string", "minLength": 1 }
      }
    },
    "launch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["arguments", "requirement"],
      "properties": {
        "arguments": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "requirement": { "enum": ["required", "recommended"] }
      }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["launch"],
      "properties": { "launch": { "$ref": "#/$defs/launch" } }
    },
    "game": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "architecture", "status", "match", "addon"],
      "allOf": [
        {
          "if": { "required": ["renodx_config"] },
          "then": { "required": ["profile_id"] }
        },
        {
          "if": {
            "required": ["profile_id"],
            "properties": { "profile_id": { "const": "ue_extended" } }
          },
          "then": {
            "properties": {
              "renodx_config": {
                "properties": {
                  "settings": {
                    "items": {
                      "properties": {
                        "key": {
                          "enum": [
                            "Upgrade_B8G8R8A8_TYPELESS",
                            "Upgrade_B8G8R8A8_UNORM",
                            "Upgrade_R8G8B8A8_TYPELESS",
                            "Upgrade_R8G8B8A8_UNORM",
                            "Upgrade_R10G10B10A2_UNORM",
                            "Upgrade_R10G10B10A2_TYPELESS",
                            "Upgrade_R11G11B10_FLOAT",
                            "Upgrade_R16G16B16A16_TYPELESS",
                            "Upgrade_CopyDestinations"
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "required": ["profile_id"],
            "properties": { "profile_id": { "const": "unreal_legacy" } }
          },
          "then": {
            "properties": {
              "renodx_config": {
                "properties": {
                  "settings": {
                    "items": {
                      "properties": {
                        "key": {
                          "not": {
                            "enum": [
                              "Swapchain_Encoding",
                              "Scaling_Offset",
                              "Tonemap_Offset",
                              "Blit_Copy_Hack",
                              "Use_Swapchain_Proxy",
                              "Force_Pipeline_Cloning"
                            ]
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "required": ["profile_id"],
            "properties": { "profile_id": { "const": "unity" } }
          },
          "then": {
            "properties": {
              "renodx_config": {
                "properties": {
                  "settings": {
                    "items": {
                      "properties": {
                        "key": {
                          "not": { "enum": ["ForceBorderless", "Upgrade_UseSCRGB"] }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "architecture": { "$ref": "#/$defs/architecture" },
        "status": { "$ref": "#/$defs/status" },
        "match": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/match" } },
        "addon": { "$ref": "#/$defs/addon" },
        "profile_id": { "enum": ["ue_extended", "unreal_legacy", "unity"] },
        "processing_path": { "$ref": "#/$defs/processingPath" },
        "renodx_config": { "$ref": "#/$defs/renodxConfig" },
        "inherit_page_guidance": { "type": "boolean" },
        "guidance": { "type": "array", "items": { "$ref": "#/$defs/guidance" } },
        "requirements": { "$ref": "#/$defs/requirements" },
        "availability": { "$ref": "#/$defs/availability" },
        "constraints": { "$ref": "#/$defs/constraints" },
        "proxy_dll": { "type": "string", "pattern": "^[^/\\\\]+$" }
      }
    },
    "engineAddon": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "slug": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
        "sources": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x64", "x86"],
          "properties": {
            "x64": { "type": "string", "format": "uri", "pattern": "^https://" },
            "x86": { "type": "string", "format": "uri", "pattern": "^https://" }
          }
        }
      }
    },
    "engineProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "engine",
        "generic_fallback",
        "status",
        "addon",
        "message",
        "guidance",
        "processing_path"
      ],
      "properties": {
        "id": { "enum": ["ue_extended", "unreal_legacy", "unity"] },
        "engine": { "$ref": "#/$defs/engine" },
        "generic_fallback": { "type": "boolean" },
        "status": { "$ref": "#/$defs/status" },
        "addon": { "$ref": "#/$defs/engineAddon" },
        "message": { "$ref": "#/$defs/message" },
        "guidance": { "type": "array", "items": { "$ref": "#/$defs/guidance" } },
        "processing_path": { "$ref": "#/$defs/processingPath" }
      }
    }
  }
}
